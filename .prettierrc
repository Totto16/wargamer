{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "overrides": [
        {
            "files": ["**.ts", "eslint.config.mjs"],
            "excludeFiles": ["tsup.config.ts", "vitest.config.ts"],
            "options": {
                "trailingComma": "all",
                "tabWidth": 2,
                "semi": true,
                "singleQuote": true
            }
        }
    ]
}
